# ---------------------------------------------------------------------------
# CareerAI environment variables. Copy to `.env` and fill in as needed.
# For local development the defaults below work out of the box with the
# bundled Postgres cluster (scripts/pg.sh) and the "mock" AI provider.
# NEVER commit a real `.env` file or any secret values.
# ---------------------------------------------------------------------------

# Database (Prisma / PostgreSQL)
DATABASE_URL="postgresql://postgres@localhost:5432/careerai?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="dev-only-insecure-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave blank to disable the Google button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI provider abstraction.
# AI_PROVIDER one of: mock | openai | anthropic | gemini
# "mock" requires no API key and produces deterministic development output.
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Object storage abstraction.
# STORAGE_DRIVER one of: local | s3
# "local" stores files under ./.storage (dev only, never public).
STORAGE_DRIVER="local"
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""

# PDF generation. Path to a Chrome/Chromium executable for server-side render.
PUPPETEER_EXECUTABLE_PATH="/usr/local/bin/google-chrome"

# Payments (optional / placeholder — structured for future Stripe integration)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
